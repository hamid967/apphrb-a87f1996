{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "build:dev": "NODE_OPTIONS=--max-old-space-size=6144 vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsgo --noEmit",
    "check:imports": "tsgo --noEmit",
    "format": "prettier --write .",
    "seed:approve-hamid": "psql \"$DATABASE_URL\" -f supabase/seeds/approve_hamid.sql",
    "seed:core-system": "test -n \"$DATABASE_URL\" || { echo \"DATABASE_URL is not configured; skipping core system seed.\"; exit 0; }; psql \"$DATABASE_URL\" -f supabase/seeds/core_system.sql",
    "seed:core-system:dry": "test -n \"$DATABASE_URL\" || { echo \"DATABASE_URL is not configured; skipping core system seed dry-run.\"; exit 0; }; psql \"$DATABASE_URL\" -v dry_run=1 -f supabase/seeds/core_system.sql",
    "test:seed": "test -n \"$DATABASE_URL\" || { echo \"DATABASE_URL is not configured; skipping seed idempotency test.\"; exit 0; }; psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/test-seed-idempotency.sql",
    "test:server-fn": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/test-server-fn-queries.sql",
    "test:pv-notify": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/test-policy-violation-notifications.sql",
    "verify:seed": "test -n \"$DATABASE_URL\" || { echo \"DATABASE_URL is not configured; skipping seed verification.\"; exit 0; }; psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/verify-seed-totals.sql",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "audit:i18n:keys": "node scripts/i18n-keys-audit.mjs",
    "i18n:ci": "node scripts/i18n-ci-check.mjs",
    "i18n:ci:update": "node scripts/i18n-ci-check.mjs --update",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:redirects": "vitest run --coverage src/lib/app-url.test.ts src/routes/auth.redirect.test.ts",
    "build:analyze": "ANALYZE=true NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cap sync ios",
    "cap:sync:android": "cap sync android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android",
    "cap:update": "cap update",
    "cap:doctor": "cap doctor",
    "signing:restore:ios": "bash scripts/signing/restore-ios.sh",
    "signing:restore:android": "bash scripts/signing/restore-android.sh",
    "signing:restore": "bash scripts/signing/restore-all.sh",
    "mobile:release:ios": "bash scripts/signing/restore-ios.sh && cap sync ios && cap open ios",
    "mobile:release:android": "bash scripts/signing/restore-android.sh && cap sync android && cap open android",
    "mobile:ci:android": "bash scripts/signing/restore-android.sh && cap sync android && cd android && ./gradlew bundleRelease"
  },
