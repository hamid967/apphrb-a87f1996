{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zgzhekdyospixozsmjwi.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "aqari-hrhbs-mcp",
      "version": "0.1.0",
      "title": "Aqari by HRHBS"
    },
    "tools": [
      {
        "name": "get_my_context",
        "title": "Get my account context",
        "description": "Return the signed-in user's profile summary and active company (organization) they belong to.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_properties",
        "title": "List properties",
        "description": "List real-estate properties in the signed-in user's company. Supports optional filters by city and listing type.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Max rows to return (1-100)."
            },
            "city": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Filter by city name."
            },
            "listing_type": {
              "type": "string",
              "enum": [
                "rent",
                "sale"
              ],
              "description": "Filter by listing type: rent or sale."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_branches",
        "title": "List branches & departments",
        "description": "List branches (and their departments) belonging to the signed-in user's company.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "create_property",
        "title": "Create a property",
        "description": "Insert a new property into the signed-in user's company. Requires a title in Arabic or English.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title_ar": {
              "type": "string",
              "maxLength": 140,
              "description": "Arabic title."
            },
            "title_en": {
              "type": "string",
              "maxLength": 140,
              "description": "English title."
            },
            "property_type": {
              "type": "string",
              "enum": [
                "apartment",
                "villa",
                "office",
                "land",
                "shop",
                "building"
              ],
              "default": "apartment"
            },
            "listing_type": {
              "type": "string",
              "enum": [
                "rent",
                "sale"
              ],
              "default": "rent"
            },
            "city": {
              "type": "string",
              "maxLength": 80,
              "description": "City name."
            },
            "price": {
              "type": "number",
              "minimum": 0,
              "default": 0,
              "description": "Price in SAR."
            },
            "currency": {
              "type": "string",
              "maxLength": 8,
              "default": "SAR"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
