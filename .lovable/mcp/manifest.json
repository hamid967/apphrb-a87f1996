{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zgzhekdyospixozsmjwi.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "aqari-hrhbs-mcp",
      "version": "0.1.0",
      "title": "Aqari by HRHBS"
    },
    "tools": [
      {
        "name": "get_my_context",
        "title": "Get my account context",
        "description": "Return the signed-in user's profile summary and active company (organization) they belong to.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_properties",
        "title": "List properties",
        "description": "List real-estate properties in the signed-in user's company. Supports text search over title/city, pagination, and optional filters by city and listing type. Returns a unified {id, title, subtitle, status, date} shape.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Optional case-insensitive text search across the tool's primary fields."
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1,
              "description": "1-based page number."
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Rows per page (1-100)."
            },
            "city": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Filter by city name (exact)."
            },
            "listing_type": {
              "type": "string",
              "enum": [
                "rent",
                "sale"
              ],
              "description": "Filter by listing type: rent or sale."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_branches",
        "title": "List branches & departments",
        "description": "List branches (with their departments) for the signed-in user's company. Supports text search over branch name/address and pagination. Returns a unified {id, title, subtitle, date} shape.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Optional case-insensitive text search across the tool's primary fields."
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1,
              "description": "1-based page number."
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Rows per page (1-100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_property",
        "title": "Create a property",
        "description": "Insert a new property into the signed-in user's company. Requires a title in Arabic or English.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title_ar": {
              "type": "string",
              "maxLength": 140,
              "description": "Arabic title."
            },
            "title_en": {
              "type": "string",
              "maxLength": 140,
              "description": "English title."
            },
            "property_type": {
              "type": "string",
              "enum": [
                "apartment",
                "villa",
                "office",
                "land",
                "shop",
                "building"
              ],
              "default": "apartment"
            },
            "listing_type": {
              "type": "string",
              "enum": [
                "rent",
                "sale"
              ],
              "default": "rent"
            },
            "city": {
              "type": "string",
              "maxLength": 80,
              "description": "City name."
            },
            "price": {
              "type": "number",
              "minimum": 0,
              "default": 0,
              "description": "Price in SAR."
            },
            "currency": {
              "type": "string",
              "maxLength": 8,
              "default": "SAR"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_pending_tickets",
        "title": "List pending tickets & claims",
        "description": "List pending items for the signed-in user's company: support tickets, maintenance tickets, or expense claims. Supports text search over title/subject/number, pagination, filter by status or submission-date window, and `mine_only`. Returns a unified {id, title, subtitle, status, date} shape.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Optional case-insensitive text search across the tool's primary fields."
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1,
              "description": "1-based page number."
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Rows per page (1-100)."
            },
            "type": {
              "type": "string",
              "enum": [
                "support",
                "maintenance",
                "expense_claim"
              ],
              "default": "support",
              "description": "Which list to query."
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "Filter by a single status value. Omit to include all open statuses."
            },
            "since": {
              "type": "string",
              "format": "date-time",
              "description": "Only include items created at or after this ISO-8601 timestamp."
            },
            "until": {
              "type": "string",
              "format": "date-time",
              "description": "Only include items created before this ISO-8601 timestamp."
            },
            "mine_only": {
              "type": "boolean",
              "default": false,
              "description": "Restrict to items owned by the signed-in user (requester/submitter/assignee)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "decide_expense_claim",
        "title": "Approve or reject an expense claim",
        "description": "Approve or reject a single expense claim as the signed-in reviewer. Records the decision, decision note, reviewer id, and decision timestamp. Only users authorized by RLS (org owner/admin or app admin/super_admin) can decide; other callers get a permission error. Rejection requires a reason.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "claim_id": {
              "type": "string",
              "format": "uuid",
              "description": "The expense claim id to decide."
            },
            "decision": {
              "type": "string",
              "enum": [
                "approve",
                "reject"
              ],
              "description": "Decision to record."
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Decision note. Required when rejecting; recommended when approving."
            }
          },
          "required": [
            "claim_id",
            "decision"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_expense_claim",
        "title": "Create expense claim",
        "description": "Create a new expense claim (submitted) for the signed-in user's company. Captures amount, currency, expense date, merchant, category, notes, and an optional uploaded receipt URL. The claim number is generated automatically. Enters status 'submitted' immediately unless `as_draft` is true.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000000,
              "description": "Amount in the given currency."
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3,
              "default": "SAR",
              "description": "ISO 4217 currency code, e.g. SAR."
            },
            "expense_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date the expense was incurred (YYYY-MM-DD)."
            },
            "merchant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "description": "Merchant / vendor name."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Expense category (e.g. travel, fuel, maintenance, office)."
            },
            "notes": {
              "type": "string",
              "maxLength": 2000,
              "description": "Free-form notes describing the expense."
            },
            "receipt_url": {
              "type": "string",
              "format": "uri",
              "maxLength": 2000,
              "description": "URL of the uploaded receipt file. Use the app's receipt upload flow to get a signed or public URL first."
            },
            "as_draft": {
              "type": "boolean",
              "default": false,
              "description": "Save as draft instead of submitting for approval."
            }
          },
          "required": [
            "amount",
            "expense_date",
            "merchant"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
